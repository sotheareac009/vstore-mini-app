# Copy to .env.local for development, or .env for a deployment.
# Never commit a filled-in copy — .gitignore excludes everything but this file.

# --- Database (the existing WooCommerce install) ---
DB_NAME=vstore_prod_db
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# WordPress table prefix
DB_PREFIX=wp_

# --- Payments ---
# Merchant id used when creating the order/payment at checkout.
MERCHANT_ID=

# --- Product images ---
# NOTE: NEXT_PUBLIC_* values are inlined at build time. Set them BEFORE
# running `npm run build`, and rebuild after any change.
#
# Local development, serving from the MAMP WordPress install:
#   NEXT_PUBLIC_UPLOADS_BASE_URL=http://vstorecenter-local.com/wp-content/uploads
#   NEXT_PUBLIC_UPLOADS_FALLBACK_URL=https://vstorecenter.com/wp-content/uploads
#
# Production — point the base at the live site and leave the fallback blank:
NEXT_PUBLIC_UPLOADS_BASE_URL=https://vstorecenter.com/wp-content/uploads
NEXT_PUBLIC_UPLOADS_FALLBACK_URL=

# --- Checkout: creating the order in WooCommerce ---
# Generate a Read/Write key at:
#   WooCommerce -> Settings -> Advanced -> REST API -> Add key
# The consumer secret is shown only once, when the key is created.
WC_STORE_URL=https://vstorecenter.com
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Prices are read from WooCommerce so runtime promotions apply, then cached
# for this many seconds. This is how long a promotion change takes to appear
# in the app. Set to 0 to disable caching while testing promotions.
WC_PRICE_TTL_SECONDS=60

# --- Storefront ---
NEXT_PUBLIC_STORE_NAME=VStore
NEXT_PUBLIC_CURRENCY=USD

# Telegram account the buyer is handed off to after ordering, and for
# "Contact seller" on sold-out products. Without the @.
# Build-time value — rebuild after changing it.
NEXT_PUBLIC_TELEGRAM_SHOP=unicorn_vvipcplus

# Public storefront, used to build the product links sent to the seller.
NEXT_PUBLIC_STORE_URL=https://vstorecenter.com
